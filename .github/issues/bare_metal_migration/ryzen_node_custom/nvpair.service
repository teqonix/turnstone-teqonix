[Unit]
Description=NVIDIA Personal AI Router (PAIR) TUI tmux session
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=forking
User=${SERVICE_USER}
Group=${SERVICE_USER}
WorkingDirectory=/home/${SERVICE_USER}
Environment="HOME=/home/${SERVICE_USER}"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="TERM=xterm-256color"
Environment="LANG=C.UTF-8"
Environment="LC_ALL=C.UTF-8"
ExecStartPre=-/usr/bin/tmux kill-session -t pair
ExecStart=/usr/bin/tmux new-session -d -s pair nvpair-tui
ExecStop=/usr/bin/tmux kill-session -t pair
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
Alias=nvpair-tui.service