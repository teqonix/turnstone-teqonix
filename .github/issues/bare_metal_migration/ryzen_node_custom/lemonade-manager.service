[Unit]
Description=Turnstone Dynamic Lemonade Manager Sidecar
After=network.target network-online.target lemond.service lemonade.service
Wants=network-online.target lemond.service

[Service]
Type=simple
User=${TURNSTONE_USER_DEBIAN}
Group=${TURNSTONE_USER_DEBIAN}
WorkingDirectory=/etc/turnstone
Environment="PORT=13306"
Environment="HOST=0.0.0.0"
Environment="LEMONADE_MANAGER_MODE=${LEMONADE_MANAGER_MODE}"
Environment="LEMONADE_BACKEND_URL=http://127.0.0.1:13305"
Environment="LEMONADE_WATCHDOG_POLL_INTERVAL_SECONDS=${LEMONADE_WATCHDOG_POLL_INTERVAL_SECONDS}"
Environment="LEMONADE_IDLE_TTL_SECONDS=${LEMONADE_IDLE_TTL_SECONDS}"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=${RYZEN_CUSTOM_DIR}:/etc/turnstone"
ExecStartPre=-/bin/sh -c 'fuser -k 13306/tcp 2>/dev/null || true'
ExecStart=${LEMONADE_MANAGER_VENV_DIR}/bin/python3 ${RYZEN_CUSTOM_DIR}/dynamic_lemonade_manager.py
Restart=always
RestartSec=10s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
