#!/usr/bin/env bash
# =============================================================================
# PAIR Llama ROCm 10.0 Engine Runner (AI Toolbox Cockpit Strix Halo Port)
#
# Acts as a high-performance, drop-in inference engine wrapper for NVIDIA PAIR
# (emulating LM Studio's 'lms server' CLI or running as a direct service).
# Launches a containerized llama-server from kyuz0/amd-strix-halo-toolboxes
# built with ROCm 10.0, Direct I/O (dio), calibrated ubatches, and MTP.
# =============================================================================

set -euo pipefail

# Ensure XDG_RUNTIME_DIR is set for rootless Podman execution
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    if [ -d "/run/user/$(id -u)" ]; then
        export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    fi
fi

CONTAINER_NAME="${CONTAINER_NAME:-pair-llama-engine}"
CONFIG_FILE="${CONFIG_FILE:-/etc/turnstone/llama_rocm.conf}"
# Declare MODELS array for Multi-Model Resident Stacking (Option 2)
declare -a MODELS=()
CLI_MODEL_SPECIFIED=""

# Source optional override configuration if present
if [ -f "${CONFIG_FILE}" ]; then
    # shellcheck disable=SC1090
    source "${CONFIG_FILE}"
fi

DEFAULT_IMAGE="docker.io/kyuz0/amd-strix-halo-toolboxes:rocm-10.0-rocmfpx"
LLAMA_IMAGE="${LLAMA_IMAGE:-${DEFAULT_IMAGE}}"
PORT="${PORT:-1235}"
BIND_HOST="${BIND_HOST:-0.0.0.0}"
CONTEXT_SIZE="${CONTEXT_SIZE:-32768}"
GPU_LAYERS="${GPU_LAYERS:-999}"
LOAD_MODE="${LOAD_MODE:-dio}"
BATCH_SIZE="${BATCH_SIZE:-2048}"
UBATCH_SIZE="${UBATCH_SIZE:-2048}"
KV_CACHE_TYPE="${KV_CACHE_TYPE:-q8_0}"
USE_FLASH_ATTN="${USE_FLASH_ATTN:-1}"
PARALLEL_SEQUENCES="${PARALLEL_SEQUENCES:-1}"
EXTRA_ARGS="${EXTRA_ARGS:-}"

# Auto-discover models directory
find_models_dir() {
    local candidates=(
        "${MODELS_DIR:-}"
        "/models"
        "/models/shared"
        "/home/turnstone/silo-14/ai-playground/models"
        "/home/turnstone/silo-14/ai-playground"
        "/mnt/silo-14/ai-playground/models"
        "/mnt/silo-14/ai-playground"
        "/mnt/ai-playground/models"
        "/mnt/ai-playground"
        "/home/teqonix/silo-14/ai-playground/models"
        "/home/teqonix/silo-14/ai-playground"
        "/home/turnstone/.cache/lm-studio/models"
        "/home/teqonix/.cache/lm-studio/models"
        "${HOME}/.cache/lm-studio/models"
        "/home/turnstone/models"
        "/home/teqonix/models"
        "${HOME}/models"
    )
    # First pass: find a directory that actually contains .gguf files
    for dir in "${candidates[@]}"; do
        if [ -n "${dir}" ] && [ -d "${dir}" ] && [ -r "${dir}" ]; then
            if find "${dir}" -maxdepth 6 -type f -iname "*.gguf" ! -iname "*mtp*" 2>/dev/null | grep -q .; then
                echo "${dir}"
                return 0
            fi
        fi
    done
    # Second pass: return first existing directory
    for dir in "${candidates[@]}"; do
        if [ -n "${dir}" ] && [ -d "${dir}" ]; then
            echo "${dir}"
            return 0
        fi
    done
    echo "/models"
}

RESOLVED_MODELS_DIR="$(find_models_dir)"

# Auto-discover target model if not explicitly specified
find_model_file() {
    if [ -n "${LLAMA_MODEL_PATH:-}" ] && [ -f "${LLAMA_MODEL_PATH}" ]; then
        echo "${LLAMA_MODEL_PATH}"
        return 0
    fi
    if [ -d "${RESOLVED_MODELS_DIR}" ]; then
        # Priority 1: Qwen / Flash Next GGUF
        local qwen_candidate
        qwen_candidate="$(find "${RESOLVED_MODELS_DIR}" -maxdepth 6 -type f -iname "*qwen*.gguf" ! -iname "*mtp*" 2>/dev/null | sort | head -n 1 || true)"
        if [ -n "${qwen_candidate}" ]; then
            echo "${qwen_candidate}"
            return 0
        fi
        # Priority 2: DeepSeek GGUF
        local ds_candidate
        ds_candidate="$(find "${RESOLVED_MODELS_DIR}" -maxdepth 6 -type f -iname "*deepseek*.gguf" ! -iname "*mtp*" 2>/dev/null | sort | head -n 1 || true)"
        if [ -n "${ds_candidate}" ]; then
            echo "${ds_candidate}"
            return 0
        fi
        # Priority 3: Any GGUF (excluding MTP sidecars)
        local any_gguf
        any_gguf="$(find "${RESOLVED_MODELS_DIR}" -maxdepth 6 -type f -iname "*.gguf" ! -iname "*mtp*" 2>/dev/null | sort | head -n 1 || true)"
        if [ -n "${any_gguf}" ]; then
            echo "${any_gguf}"
            return 0
        fi
    fi
    echo ""
}

# Auto-discover MTP draft model sidecar
find_mtp_draft() {
    if [ -n "${MTP_DRAFT_PATH:-}" ] && [ -f "${MTP_DRAFT_PATH}" ]; then
        echo "${MTP_DRAFT_PATH}"
        return 0
    fi
    if [ -d "${RESOLVED_MODELS_DIR}" ]; then
        local mtp_candidate
        mtp_candidate="$(find "${RESOLVED_MODELS_DIR}" -maxdepth 6 -type f -iname "*mtp*.gguf" 2>/dev/null | head -n 1 || true)"
        if [ -n "${mtp_candidate}" ]; then
            echo "${mtp_candidate}"
            return 0
        fi
    fi
    echo ""
}

# Detect container runtime engine
detect_engine() {
    if command -v podman &>/dev/null; then
        echo "podman"
    elif command -v docker &>/dev/null; then
        echo "docker"
    else
        echo "none"
    fi
}

find_multiplexer() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local candidates=(
        "/usr/local/bin/pair-model-multiplexer"
        "/usr/bin/pair-model-multiplexer"
        "${script_dir}/pair_model_multiplexer.py"
        "/etc/turnstone/pair_model_multiplexer.py"
    )
    for c in "${candidates[@]}"; do
        if [ -x "${c}" ] || [ -f "${c}" ]; then
            echo "${c}"
            return 0
        fi
    done
    echo ""
}

resolve_model_entry() {
    local pattern="$1"
    if [ -f "${pattern}" ]; then
        echo "${pattern}"
        return 0
    fi
    # If directory, find first gguf
    if [ -d "${pattern}" ]; then
        local cand
        cand="$(find "${pattern}" -maxdepth 4 -type f -iname "*.gguf" ! -iname "*mtp*" 2>/dev/null | sort | head -n 1 || true)"
        if [ -n "${cand}" ]; then
            echo "${cand}"
            return 0
        fi
    fi
    # If glob expression
    local matched=( ${pattern} )
    if [ -f "${matched[0]:-}" ]; then
        echo "${matched[0]}"
        return 0
    fi
    echo "${pattern}"
}

start_single_server() {
    local engine
    engine="$(detect_engine)"
    if [ "${engine}" = "none" ]; then
        echo "[ERROR] Neither podman nor docker is installed. Cannot launch container." >&2
        exit 1
    fi

    local c_name="${CONTAINER_NAME:-pair-llama-engine-${PORT}}"

    # Check if container is already running and answering health checks
    if "${engine}" ps --format '{{.Names}}' | grep -qE "^(${c_name}|pair-llama-engine)$"; then
        if curl -sf "http://127.0.0.1:${PORT}/v1/models" &>/dev/null; then
            echo "[INFO] Container '${c_name}' is already running and healthy on port ${PORT}."
            exit 0
        fi
        echo "[WARN] Container '${c_name}' is running but unresponsive. Recreating..."
        "${engine}" rm -f "${c_name}" "pair-llama-engine" &>/dev/null || true
    else
        "${engine}" rm -f "${c_name}" "pair-llama-engine" &>/dev/null || true
    fi

    local target_model
    target_model="$(find_model_file)"
    if [ -z "${target_model}" ]; then
        echo "[ERROR] No GGUF model found in '${RESOLVED_MODELS_DIR}' or candidate search paths." >&2
        echo "[ERROR] llama-server requires an explicit GGUF model file to start." >&2
        echo "[ERROR] Please place a .gguf model in /models or configure LLAMA_MODEL_PATH in /etc/turnstone/llama_rocm.conf" >&2
        exit 1
    else
        echo "[INFO] Selected target model: ${target_model}"
    fi

    local mtp_draft
    mtp_draft="$(find_mtp_draft)"
    [ -n "${mtp_draft}" ] && echo "[INFO] Selected MTP sidecar: ${mtp_draft}"

    # Build container engine run arguments
    local engine_args=(
        "run" "-d"
        "--name" "${c_name}"
        "--restart" "always"
        "-p" "${PORT}:${PORT}"
    )

    # Hardware devices (ROCm / KFD / DRI)
    if [ -e "/dev/kfd" ]; then
        engine_args+=("--device" "/dev/kfd")
    fi
    if [ -d "/dev/dri" ]; then
        engine_args+=("--device" "/dev/dri")
    fi

    # Device permissions & user namespaces
    if [ "${engine}" = "podman" ]; then
        engine_args+=(
            "--group-add" "keep-groups"
            "--userns=keep-id"
            "--security-opt" "label=disable"
            "--security-opt" "seccomp=unconfined"
        )
    else
        engine_args+=(
            "--group-add" "video"
            "--group-add" "render"
            "--security-opt" "seccomp=unconfined"
        )
    fi

    # RDMA / Infiniband support if available
    if [ -d "/dev/infiniband" ]; then
        engine_args+=("--device" "/dev/infiniband" "--group-add" "rdma" "--ulimit" "memlock=-1")
    fi

    # Strix Halo ROCm 10.0 / HIP Environment flags
    engine_args+=(
        "-e" "ROCBLAS_USE_HIPBLASLT=1"
        "-e" "HSA_OVERRIDE_GFX_VERSION=11.5.1"
        "-e" "GGML_HIP_ENABLE_UNIFIED_MEMORY=1"
        "-e" "XDG_CACHE_HOME=/tmp"
    )

    # Mount models directory
    local model_abs
    model_abs="$(realpath "${target_model}" 2>/dev/null || echo "${target_model}")"
    local model_dir
    model_dir="$(dirname "${model_abs}")"

    if [ -d "/home/turnstone" ]; then
        engine_args+=("-v" "/home/turnstone:/home/turnstone:ro")
    fi

    if [ -d "${RESOLVED_MODELS_DIR}" ] && [[ "${model_abs}" == "${RESOLVED_MODELS_DIR}"* ]]; then
        engine_args+=("-v" "${RESOLVED_MODELS_DIR}:/models:ro")
    else
        engine_args+=("-v" "${model_dir}:${model_dir}:ro")
        if [ -d "${RESOLVED_MODELS_DIR}" ]; then
            engine_args+=("-v" "${RESOLVED_MODELS_DIR}:/models:ro")
        fi
    fi

    engine_args+=("${LLAMA_IMAGE}")

    # Build inner llama-server command
    local server_cmd=(
        "llama-server"
        "--host" "${BIND_HOST}"
        "--port" "${PORT}"
        "-c" "${CONTEXT_SIZE}"
        "-ngl" "${GPU_LAYERS}"
        "-fa" "${USE_FLASH_ATTN}"
        "--load-mode" "${LOAD_MODE}"
        "-b" "${BATCH_SIZE}"
        "-ub" "${UBATCH_SIZE}"
        "-np" "${PARALLEL_SEQUENCES}"
        "--cache-type-k" "${KV_CACHE_TYPE}"
        "--cache-type-v" "${KV_CACHE_TYPE}"
    )

    if [ -d "${RESOLVED_MODELS_DIR}" ] && [[ "${model_abs}" == "${RESOLVED_MODELS_DIR}"* ]]; then
        local rel_model
        rel_model="$(realpath --relative-to="${RESOLVED_MODELS_DIR}" "${model_abs}" 2>/dev/null || basename "${model_abs}")"
        server_cmd+=("-m" "/models/${rel_model}")
    else
        server_cmd+=("-m" "${model_abs}")
    fi

    if [ -n "${mtp_draft}" ]; then
        if [ -d "${RESOLVED_MODELS_DIR}" ] && [[ "${mtp_draft}" == "${RESOLVED_MODELS_DIR}"* ]]; then
            local rel_mtp
            rel_mtp="$(realpath --relative-to="${RESOLVED_MODELS_DIR}" "${mtp_draft}" 2>/dev/null || basename "${mtp_draft}")"
            server_cmd+=("--model-draft" "/models/${rel_mtp}" "--spec-draft-p-min" "0.75")
        else
            server_cmd+=("--model-draft" "${mtp_draft}" "--spec-draft-p-min" "0.75")
        fi
    fi

    if [ -n "${EXTRA_ARGS}" ]; then
        # shellcheck disable=SC2086
        server_cmd+=(${EXTRA_ARGS})
    fi

    echo "[INFO] Launching ROCm 10.0 llama-server container '${c_name}'..."
    "${engine}" "${engine_args[@]}" "${server_cmd[@]}"

    # Quick 1.5-second check: verify container didn't crash immediately on launch
    sleep 1.5
    if ! "${engine}" ps --format '{{.Names}}' | grep -q "^${c_name}$"; then
        echo "[ERROR] Container '${c_name}' failed to start or crashed on launch." >&2
        echo "=== Container Logs ===" >&2
        "${engine}" logs --tail 30 "${c_name}" 2>&1 >&2 || true
        exit 1
    fi

    # Exit 0 immediately: PAIR's engine manager handles readiness polling via manifest 'ready' config (timeout_s: 60)
    echo "[SUCCESS] ROCm 10.0 llama-server container '${c_name}' is running."
    echo "[INFO] PAIR engine manager is monitoring readiness on http://127.0.0.1:${PORT}/v1/models."
    exit 0
}

start_multi_server() {
    local engine
    engine="$(detect_engine)"
    if [ "${engine}" = "none" ]; then
        echo "[ERROR] Neither podman nor docker is installed. Cannot launch container." >&2
        exit 1
    fi

    local multiplexer_bin
    multiplexer_bin="$(find_multiplexer)"
    if [ -z "${multiplexer_bin}" ]; then
        echo "[ERROR] pair-model-multiplexer executable not found. Cannot run multi-model mode." >&2
        exit 1
    fi

    local base_internal_port=$((PORT + 10000))
    local backend_urls=()
    local mtp_draft
    mtp_draft="$(find_mtp_draft)"

    echo "[INFO] Starting ${#MODELS[@]} resident models in Multi-Model LM Studio masquerade mode..."

    for idx in "${!MODELS[@]}"; do
        local raw_model="${MODELS[$idx]}"
        local resolved_model
        resolved_model="$(resolve_model_entry "${raw_model}")"

        if [ ! -f "${resolved_model}" ]; then
            echo "[WARN] Model file not found on host: '${raw_model}' (resolved: '${resolved_model}'). Skipping." >&2
            continue
        fi

        local inst_port=$((base_internal_port + idx))
        local inst_cname="pair-llama-inst-${PORT}-${idx}"
        backend_urls+=("http://127.0.0.1:${inst_port}")

        echo "[INFO] [Model $((idx+1))/${#MODELS[@]}] Preparing ${resolved_model} on internal port ${inst_port}..."

        # If already running and responsive, keep it
        if "${engine}" ps --format '{{.Names}}' | grep -qE "^${inst_cname}$"; then
            if curl -sf "http://127.0.0.1:${inst_port}/v1/models" &>/dev/null; then
                echo "[INFO] Instance '${inst_cname}' is already running and healthy on port ${inst_port}."
                continue
            fi
            echo "[WARN] Instance '${inst_cname}' is running but unresponsive. Recreating..."
            "${engine}" rm -f "${inst_cname}" &>/dev/null || true
        else
            "${engine}" rm -f "${inst_cname}" &>/dev/null || true
        fi

        local model_abs
        model_abs="$(realpath "${resolved_model}" 2>/dev/null || echo "${resolved_model}")"
        local model_dir
        model_dir="$(dirname "${model_abs}")"

        # Determine parent model directory to mount
        local top_model_dir
        if [[ "${model_dir}" == /home/turnstone/models* ]]; then
            top_model_dir="/home/turnstone/models"
        elif [[ "${model_dir}" == /home/turnstone/.lmstudio* ]]; then
            top_model_dir="/home/turnstone/.lmstudio"
        elif [[ "${model_dir}" == /home/teqonix/models* ]]; then
            top_model_dir="/home/teqonix/models"
        elif [[ "${model_dir}" == /models* ]]; then
            top_model_dir="/models"
        elif [ -d "${RESOLVED_MODELS_DIR}" ] && [[ "${model_dir}" == "${RESOLVED_MODELS_DIR}"* ]]; then
            top_model_dir="${RESOLVED_MODELS_DIR}"
        else
            top_model_dir="${model_dir}"
        fi

        local inst_engine_args=(
            "run" "-d"
            "--name" "${inst_cname}"
            "--restart" "always"
            "-p" "127.0.0.1:${inst_port}:${inst_port}"
        )

        if [ -e "/dev/kfd" ]; then
            inst_engine_args+=("--device" "/dev/kfd")
        fi
        if [ -d "/dev/dri" ]; then
            inst_engine_args+=("--device" "/dev/dri")
        fi

        if [ "${engine}" = "podman" ]; then
            inst_engine_args+=(
                "--group-add" "keep-groups"
                "--userns=keep-id"
                "--security-opt" "label=disable"
                "--security-opt" "seccomp=unconfined"
            )
        else
            inst_engine_args+=(
                "--group-add" "video"
                "--group-add" "render"
                "--security-opt" "seccomp=unconfined"
            )
        fi

        if [ -d "/dev/infiniband" ]; then
            inst_engine_args+=("--device" "/dev/infiniband" "--group-add" "rdma" "--ulimit" "memlock=-1")
        fi

        inst_engine_args+=(
            "-e" "ROCBLAS_USE_HIPBLASLT=1"
            "-e" "HSA_OVERRIDE_GFX_VERSION=11.5.1"
            "-e" "GGML_HIP_ENABLE_UNIFIED_MEMORY=1"
            "-e" "XDG_CACHE_HOME=/tmp"
        )

        if [ -d "/home/turnstone" ]; then
            inst_engine_args+=("-v" "/home/turnstone:/home/turnstone:ro")
        fi

        inst_engine_args+=("-v" "${top_model_dir}:${top_model_dir}:ro")

        if [ -d "${RESOLVED_MODELS_DIR}" ] && [ "${RESOLVED_MODELS_DIR}" != "${top_model_dir}" ]; then
            inst_engine_args+=("-v" "${RESOLVED_MODELS_DIR}:/models:ro")
        fi
        if [ "${top_model_dir}" != "/models" ] && [ ! -d "/models" ]; then
            inst_engine_args+=("-v" "${top_model_dir}:/models:ro")
        fi

        inst_engine_args+=("${LLAMA_IMAGE}")

        local base_alias
        base_alias="$(basename "${model_abs}" .gguf | sed -E 's/-00001-of-[0-9]+//')"

        local inst_cmd=(
            "llama-server"
            "--host" "0.0.0.0"
            "--port" "${inst_port}"
            "-c" "${CONTEXT_SIZE}"
            "-ngl" "${GPU_LAYERS}"
            "-fa" "${USE_FLASH_ATTN}"
            "--load-mode" "${LOAD_MODE}"
            "-b" "${BATCH_SIZE}"
            "-ub" "${UBATCH_SIZE}"
            "-np" "${PARALLEL_SEQUENCES}"
            "--cache-type-k" "${KV_CACHE_TYPE}"
            "--cache-type-v" "${KV_CACHE_TYPE}"
            "--alias" "${base_alias}"
            "-m" "${model_abs}"
        )

        if [ -n "${mtp_draft}" ] && [[ "${model_abs,,}" == *"qwen"* ]]; then
            inst_cmd+=("--model-draft" "${mtp_draft}" "--spec-draft-p-min" "0.75")
        fi

        if [ -n "${EXTRA_ARGS}" ]; then
            # shellcheck disable=SC2086
            inst_cmd+=(${EXTRA_ARGS})
        fi

        echo "[INFO] Spawning instance container '${inst_cname}' for ${base_alias}..."
        "${engine}" "${inst_engine_args[@]}" "${inst_cmd[@]}"
    done

    if [ "${#backend_urls[@]}" -eq 0 ]; then
        echo "[ERROR] None of the models specified in MODELS array could be found or launched." >&2
        exit 1
    fi

    # Assemble comma-separated backends list
    local backends_joined
    backends_joined="$(IFS=,; echo "${backend_urls[*]}")"

    local pid_dir="${XDG_RUNTIME_DIR:-/tmp}"
    local pid_file="${pid_dir}/pair-multiplexer-${PORT}.pid"

    # Stop prior multiplexer if running on this port
    if [ -f "${pid_file}" ]; then
        local old_pid
        old_pid="$(cat "${pid_file}" 2>/dev/null || true)"
        if [ -n "${old_pid}" ] && kill -0 "${old_pid}" 2>/dev/null; then
            echo "[INFO] Stopping previous multiplexer PID ${old_pid}..."
            kill "${old_pid}" 2>/dev/null || true
            sleep 0.5
        fi
        rm -f "${pid_file}"
    fi
    pkill -f "pair_model_multiplexer.*--port ${PORT}" 2>/dev/null || true
    local port_pids
    port_pids="$(ss -tulpn "sport = :${PORT}" 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 || true)"
    if [ -n "${port_pids}" ]; then
        for p in ${port_pids}; do
            kill -9 "${p}" 2>/dev/null || true
        done
        sleep 0.5
    fi

    echo "[INFO] Launching PAIR Model Multiplexer on port ${PORT} (routing to: ${backends_joined})..."
    python3 "${multiplexer_bin}" \
        --bind "${BIND_HOST}" \
        --port "${PORT}" \
        --backends "${backends_joined}" \
        --pid-file "${pid_file}" </dev/null >>"${pid_dir}/pair-multiplexer-${PORT}.log" 2>&1 &

    sleep 1.0

    if [ -f "${pid_file}" ]; then
        local new_pid
        new_pid="$(cat "${pid_file}" 2>/dev/null || true)"
        if ! kill -0 "${new_pid}" 2>/dev/null; then
            echo "[ERROR] Multiplexer process failed to start or crashed." >&2
            exit 1
        fi
    fi

    echo "[SUCCESS] Multi-Model resident stack is running on port ${PORT}."
    echo "[INFO] PAIR engine manager is monitoring readiness on http://127.0.0.1:${PORT}/v1/models."
    exit 0
}

start_server() {
    local num_models="${#MODELS[@]}"

    if [ -n "${CLI_MODEL_SPECIFIED:-}" ]; then
        start_single_server
    elif [ "${num_models}" -gt 1 ]; then
        start_multi_server
    elif [ "${num_models}" -eq 1 ]; then
        if [ -z "${LLAMA_MODEL_PATH:-}" ]; then
            LLAMA_MODEL_PATH="${MODELS[0]}"
        fi
        start_single_server
    else
        start_single_server
    fi
}

stop_server() {
    local engine
    engine="$(detect_engine)"
    local pid_dir="${XDG_RUNTIME_DIR:-/tmp}"
    local pid_file="${pid_dir}/pair-multiplexer-${PORT}.pid"

    # 1. Stop multiplexer if running
    if [ -f "${pid_file}" ]; then
        local m_pid
        m_pid="$(cat "${pid_file}" 2>/dev/null || true)"
        if [ -n "${m_pid}" ]; then
            echo "[INFO] Stopping multiplexer PID ${m_pid}..."
            kill "${m_pid}" 2>/dev/null || true
        fi
        rm -f "${pid_file}"
    fi
    pkill -f "pair_model_multiplexer.*--port ${PORT}" 2>/dev/null || true
    local port_pids
    port_pids="$(ss -tulpn "sport = :${PORT}" 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 || true)"
    if [ -n "${port_pids}" ]; then
        for p in ${port_pids}; do
            kill -9 "${p}" 2>/dev/null || true
        done
        sleep 0.5
    fi

    # 2. Stop container instances
    if [ "${engine}" != "none" ]; then
        echo "[INFO] Stopping ROCm llama-server containers for port ${PORT}..."
        local containers_to_stop
        containers_to_stop="$("${engine}" ps -a --format '{{.Names}}' | grep -E "^(pair-llama-inst-${PORT}-|pair-llama-engine-${PORT}$|pair-llama-engine$)" || true)"
        if [ -n "${containers_to_stop}" ]; then
            echo "${containers_to_stop}" | xargs -r "${engine}" stop &>/dev/null || true
            echo "${containers_to_stop}" | xargs -r "${engine}" rm -f &>/dev/null || true
        fi
        echo "[SUCCESS] All llama containers stopped."
    fi
}

status_server() {
    if curl -sf "http://127.0.0.1:${PORT}/v1/models"; then
        echo ""
        exit 0
    fi
    echo "[ERROR] Server is not responding on port ${PORT}." >&2
    exit 1
}

# Command Line Argument Dispatch (supports LM Studio 'lms server start/stop', direct 'start/stop', and help/version)
COMMAND="${1:-status}"
if [ "${COMMAND}" = "-h" ] || [ "${COMMAND}" = "--help" ] || [ "${COMMAND}" = "help" ]; then
    echo "Usage: $0 [server start|server stop|start|stop|status] [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --port, -p <port>       Set listen port [default: ${PORT}]"
    echo "  --bind, -b <host>       Set bind host [default: ${BIND_HOST}]"
    echo "  --model, -m <path>      Specify explicit GGUF model path"
    echo "  -h, --help              Show this help message"
    echo "  -v, --version           Show version information"
    exit 0
fi

shift || true

# Parse LM Studio subcommand structure (e.g. 'server start --port 1235' or 'lms ps')
if [ "${COMMAND}" = "server" ]; then
    COMMAND="${1:-start}"
    shift || true
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --port|-p)
            PORT="$2"
            shift 2
            ;;
        --bind|-b)
            BIND_HOST="$2"
            shift 2
            ;;
        --model|-m)
            LLAMA_MODEL_PATH="$2"
            CLI_MODEL_SPECIFIED="true"
            shift 2
            ;;
        -h|--help|help)
            echo "Usage: $0 [server start|server stop|start|stop|status] [OPTIONS]"
            exit 0
            ;;
        *)
            shift
            ;;
    esac
done

case "${COMMAND}" in
    start)
        start_server
        ;;
    stop)
        stop_server
        ;;
    status|ps|loaded)
        status_server
        ;;
    version|--version|-v)
        echo "PAIR Llama ROCm Engine Wrapper 1.0 (ai-toolbox-cockpit optimizations)"
        exit 0
        ;;
    *)
        echo "Unknown command: ${COMMAND}. Valid options: start, stop, status." >&2
        exit 1
        ;;
esac
